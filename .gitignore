# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & secrets — NEVER commit these
.env
.env.local
.env.production
.env.*.local
credentials.json

# Vercel
.vercel

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# brain.md auto-sync hook state (local bookkeeping, not shared)
.claude/.brain-md-sync-state.json

# Logs
logs/
*.log

# Build outputs
dist/
build/
E-Marketing-Architecture.pdf
brain.md

# Signature source image (raw original, untracked for privacy).
# NOTE: public/signature.png must STAY tracked — the server reads it at
# startup and Vercel deploys need it, else letters lose the signature.
# Never ignore public/ as a whole: the entire frontend lives there.
public/signature.jpeg
# Generated WhatsApp message reference — rebuild, do not commit.
whatsapp-message-formats.pdf
code-review-findings.pdf

# Python bytecode. local/db.py (a standalone Flask DB browser, no part of this
# app) is run from time to time and leaves these behind.
__pycache__/
*.pyc

# Personal working files — tools, notes and documents that are not part of the
# app and never ship. Kept in one folder so the repo root stays readable:
# right now local/db.py (Flask DB browser), the architecture PDF, and a code
# extract. Nothing here is required by the app — db.py reads ../.env, which is
# the only path that points back out.
local/
